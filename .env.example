# Copy to .env, fill values, and restart the app AND receiver.
# Existing process environment variables take precedence over this file.
# Keep SMTP_PASSWORD quoted; values are not interpolated.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The application refuses to start without a real value.
SECRET_KEY=
APP_NAME=RansomShield
# Leave blank for local SQLite. Set a PostgreSQL URL for a hosted deployment.
DATABASE_URL=

# true serves the Flask development server; false (default) serves waitress.
FLASK_DEBUG=false
PORT=5000
# Keep loopback behind a reverse proxy; use 0.0.0.0 only for a trusted LAN lab.
APP_HOST=127.0.0.1
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=''
RESPONSE_EMAIL_FROM=
# Optional fallback for alerts with no linked account. Owned alerts use that
# user's account email address as the recipient.
RESPONSE_EMAIL_TO=

# Authentication provider. Keep local until Firebase email/password is enabled
# and the server has Firebase Admin Application Default Credentials.
AUTH_PROVIDER=local
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# For local Firebase Admin verification, set GOOGLE_APPLICATION_CREDENTIALS in
# your shell to a protected service-account JSON path, or use Google ADC. Never
# paste or commit a service-account private key.
GOOGLE_APPLICATION_CREDENTIALS=

# For implicit TLS use SMTP_PORT=465 and SMTP_SECURITY=ssl.
# Email alerts go to the signed-in account when SMTP is configured.
# Optional independent HTTPS webhook:
RESPONSE_WEBHOOK_URL=

# Response policy. Disabled by default: alerts are recorded without moving files.
# The application's current live-monitor and CSV workflows are audit-only.
AUTO_QUARANTINE=false
QUARANTINE_MODE=dry-run

# Monitoring. Events arrive from Windows notifications; a full snapshot sweep
# runs every MONITOR_RECONCILE_SECONDS to catch anything watchdog missed.
MONITOR_TARGET_PATH=instance/monitor_target
MONITOR_INTERVAL_SECONDS=2
MONITOR_RECONCILE_SECONDS=30

# SILRAD benchmark files/model. Use a persistent Render disk path if available.
SILRAD_DATA_DIR=instance/silrad

# Optional endpoint event API. Generate a long random value and keep it secret.
AGENT_API_TOKEN=
# Account email that owns events sent with the shared endpoint-agent token.
# Agent events are rejected until this verified application account exists.
AGENT_OWNER_EMAIL=
