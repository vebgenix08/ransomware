# Copy to .env, fill values, and restart the app AND receiver.
# Existing process environment variables take precedence over this file.
# Keep SMTP_PASSWORD quoted; values are not interpolated.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The application refuses to start without a real value.
SECRET_KEY=

# true serves the Flask development server; false (default) serves waitress.
FLASK_DEBUG=false
PORT=5000
# Set true only when served over HTTPS.
SESSION_COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=''
RESPONSE_EMAIL_FROM=
RESPONSE_EMAIL_TO=

# For implicit TLS use SMTP_PORT=465 and SMTP_SECURITY=ssl.
# Leave RESPONSE_EMAIL_TO empty to disable email notifications.
# Optional independent HTTPS webhook:
RESPONSE_WEBHOOK_URL=

# Response policy. AUTO_QUARANTINE=false records alerts only.
# QUARANTINE_MODE=dry-run validates each candidate and records what would be
# moved without touching any file. Use enabled for real containment.
AUTO_QUARANTINE=true
QUARANTINE_MODE=enabled

# Monitoring. Events arrive from Windows notifications; a full snapshot sweep
# runs every MONITOR_RECONCILE_SECONDS to catch anything watchdog missed.
MONITOR_INTERVAL_SECONDS=2
MONITOR_RECONCILE_SECONDS=30
