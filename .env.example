# Copy to .env, fill values, and restart the app AND receiver.
# Existing process environment variables take precedence over this file.
# Keep SMTP_PASSWORD quoted; values are not interpolated.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=''
RESPONSE_EMAIL_FROM=
RESPONSE_EMAIL_TO=

# For implicit TLS use SMTP_PORT=465 and SMTP_SECURITY=ssl.
# Leave RESPONSE_EMAIL_TO empty to disable email notifications.
# Optional independent HTTPS webhook:
RESPONSE_WEBHOOK_URL=
